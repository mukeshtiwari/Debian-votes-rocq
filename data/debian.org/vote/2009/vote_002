      <li>Wouter Verhelst [<a href="mailto:wouter@debian.org">wouter@debian.org</a>] [<a href='https://lists.debian.org/debian-vote/2009/03/msg00253.html'>mail</a>] </li>
      <li>Matthew Vernon [<a href="mailto:matthew@debian.org">matthew@debian.org</a>] [<a href='https://lists.debian.org/debian-vote/2009/03/msg00261.html'>mail</a>] </li>
      <li>Anthony Towns [<a href="mailto:ajt@debian.org">ajt@debian.org</a>] [<a href='https://lists.debian.org/debian-vote/2009/03/msg00265.html'>mail</a>] </li>
      <li>Ian Jackson [<a href="mailto:awj@debian.org">awj@debian.org</a>] [<a href='https://lists.debian.org/debian-vote/2009/03/msg00266.html'>mail</a>] </li>
      <li>Bill Allombert [<a href="mailto:ballombe@debian.org">ballombe@debian.org</a>] [<a href='https://lists.debian.org/debian-vote/2009/03/msg00270.html'>mail</a>] </li>
      <li>Anibal Monsalve Salazar [<a href="mailto:anibal@debian.org">anibal@debian.org</a>] [<a href='https://lists.debian.org/debian-vote/2009/03/msg00271.html'>mail</a>] </li>
      <li>Charles Plessy [<a href="mailto:plessy@debian.org">plessy@debian.org</a>] [<a href='https://lists.debian.org/debian-vote/2009/03/msg00275.html'>mail</a>] </li>
      <li>Steve Langasek [<a href="mailto:vorlon@debian.org">vorlon@debian.org</a>] [<a href='https://lists.debian.org/debian-vote/2009/03/msg00281.html'>mail</a>] </li>
      <li>Robert Millan [<a href="mailto:rmh@debian.org">rmh@debian.org</a>] [<a href='https://lists.debian.org/debian-vote/2009/03/msg00299.html'>mail</a>] </li>
