   	           <td>&nbsp;</td>
   	           <td>182</td>
   	           <td>394</td>
   	         </tr>
   	         <tr>
   	           <th>Option 3</th>
   	           <td>438</td>
   	           <td>287</td>
   	           <td>&nbsp;</td>
   	           <td>442</td>
   	         </tr>
   	         <tr>
